[Unit]
Description=CARLA network control center
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/mnt/simulations/control-center
ExecCondition=/usr/bin/test -x /mnt/simulations/control-center/.venv/bin/python
ExecStart=/mnt/simulations/control-center/run.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=180
KillMode=mixed
LimitNOFILE=65536
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
