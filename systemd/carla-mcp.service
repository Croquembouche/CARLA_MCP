[Unit]
Description=CARLA Control Center MCP bridge
After=network.target carla-control-center.service

[Service]
Type=simple
WorkingDirectory=/mnt/simulations/control-center
Environment=CARLA_WEBUI_URL=http://127.0.0.1:8095
Environment=CARLA_WEBUI_PUBLIC_URL=http://127.0.0.1:8095
ExecStart=/mnt/simulations/control-center/run-mcp.sh --transport streamable-http --host 127.0.0.1 --port 8096
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
